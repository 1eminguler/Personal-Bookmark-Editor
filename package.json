{
  "name": "sahsi-bookmark",
  "version": "1.0.0",
  "description": "Modern, Transparent, Drag-and-Drop Bookmark Sidebar Extension for Chrome and Brave",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:icons": "node scripts/generate-icons.js",
    "build:pages": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build": "npm run generate:icons && npm run build:pages && npm run build:content",
    "pack": "npm run build && node scripts/pack-zip.js",
    "test": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/archiver": "^6.0.4",
    "@types/chrome": "^0.0.309",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^7.0.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
